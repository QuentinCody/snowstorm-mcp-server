{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "snowstorm-mcp-server",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"alias": {
		"ai": "./src/ai-stub.ts"
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"SnowstormDataDO"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"MyMCP"
			],
			"tag": "v2"
		},
		{
			"tag": "v3-purge-mymcp",
			"deleted_classes": [
				"MyMCP"
			]
		},
		{
			"tag": "v4-readd-mymcp",
			"new_sqlite_classes": [
				"MyMCP"
			]
		},
		{
			"tag": "mcp-2026-07-28-stateless",
			"deleted_classes": ["MyMCP"]
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "SnowstormDataDO",
				"name": "SNOWSTORM_DATA_DO"
			}]
	},
	"vars": {
		// SNOMED CT FHIR terminology base. tx.fhir.org is HL7's keyless reference
		// server (SNOMED CT International). browser.ihtsdotools.org is NOT usable:
		// SNOMED International edge-blocks our egress. Alternate, AU edition:
		// "https://r4.ontoserver.csiro.au/fhir".
		"SNOMED_TX_BASE": "https://tx.fhir.org/r4"
	},
	"worker_loaders": [
		{
			"binding": "CODE_MODE_LOADER"
		}
	],
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8829
	}
}
